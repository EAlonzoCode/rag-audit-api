# --- Application ---
APP_NAME=rag-audit-api
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# --- LLM Provider ---
LLM_PROVIDER=mock       # mock | ollama | gemini
LLM_MODEL=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=512

# --- Gemini (solo si LLM_PROVIDER=gemini) ---
GEMINI_API_KEY=

# --- Ollama (solo si LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- RAG ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=5

# --- Paths ---
# En dev apunta a ./data ; en prod puede apuntar a /mnt/d/rag-audit-data
DATA_DIR=./data
FAISS_INDEX_PATH=./data/faiss.index

# --- Observability ---
LOG_FORMAT=json
